{
  "name": "llm-testrunner-components",
  "version": "2.2.0",
  "description": "A Stencil web component library for LLM test runner functionality",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/llm-testrunner-components/llm-testrunner-components.esm.js",
  "exports": {
    "./react": {
      "import": "./dist/react/components.js",
      "require": "./dist/react/components.js",
      "types": "./dist/react/components.d.ts"
    },
    "./react/types": {
      "types": "./dist/types/index.d.ts"
    },
    "./schema": {
      "import": "./dist/collection/schemas/expected-outcome.js",
      "types": "./dist/types/schemas/expected-outcome.d.ts"
    },
    "././dist/components/*": {
      "import": "./dist/components/*",
      "require": "./dist/components/*",
      "types": "./dist/components/*"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    },
    "./dist/*": {
      "import": "./dist/*",
      "types": "./dist/*"
    },
    "./headless": {
      "types": "./dist/headless/index.d.mts",
      "import": "./dist/headless/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FluxonApps/llm-testrunner-lib.git"
  },
  "bugs": {
    "url": "https://github.com/FluxonApps/llm-testrunner-lib/issues"
  },
  "homepage": "https://github.com/FluxonApps/llm-testrunner-lib#readme",
  "author": "Fluxon Apps LLC",
  "files": [
    "dist/",
    "loader/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e --passWithNoTests",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "build": "stencil build && tsc --project tsconfig.react.json && tsup",
    "publish": "npm publish",
    "prepublishOnly": "npm run build",
    "watch": "concurrently -n \"Stencil Build,React Wrapper\" -c \"cyan,magenta\" \"stencil build --watch\" \"wait-on generated/react/components.ts && npm run watch:react-wrapper\"",
    "build:react": "tsc --project tsconfig.react.json",
    "watch:react-wrapper": "nodemon --watch generated/react --ext ts,tsx --exec \"tsc --project tsconfig.react.json\"",
    "build:all": "npm run build && npm run build:react",
    "prepare": "npm run build:all",
    "build-publish": "npm run build:all && npm run just-publish",
    "just-publish": "npm publish --access=public",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "license-check": "licensee",
    "release": "bash scripts/release.sh",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@stencil/react-output-target": "^1.2.0",
    "@xenova/transformers": "^2.17.2",
    "bleu-score": "^1.0.4",
    "js-rouge": "^3.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@stencil/core": "^4.27.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.5",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "licensee": "^12.0.1",
    "nodemon": "^3.1.11",
    "prettier": "^3.6.2",
    "puppeteer": "^24.3.0",
    "typescript-eslint": "^8.65.0",
    "wait-on": "^9.0.3",
    "tsup": "^8.5.0"
  },
  "peerDependencies": {
    "jest": "^29.0.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "license": "MIT",
  "overrides": {
    "protobufjs": "^7.5.5",
    "esbuild": "^0.28.1",
    "sharp": "^0.35.0",
    "minimatch": "^10.2.6"
  },
  "keywords": [
    "web-components",
    "stencil",
    "react",
    "typescript",
    "jest",
    "llm-testing",
    "headless"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "puppeteer@24.39.1": true
  }
}
